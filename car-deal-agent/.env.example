# Copy to .env and fill in. Never commit the real .env.

# Claude API key for the listing analysis (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Telegram bot: create one with @BotFather, then send it a message and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: chat ids of friends who may send ad links to the bot (comma
# separated). Their checks use your Claude credit; alerts stay with you.
# The bot tells you the id when someone unknown writes to it.
TELEGRAM_ALLOWED_CHATS=
